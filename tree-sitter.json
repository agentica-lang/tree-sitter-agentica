{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "agentica",
      "camelcase": "Agentica",
      "title": "Agentica",
      "scope": "source.agentica",
      "path": ".",
      "file-types": [
        "agc"
      ],
      "injection-regex": "^agentica$",
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.3.0",
    "license": "MIT",
    "description": "Agentica grammar for tree-sitter",
    "authors": [
      {
        "name": "Johanderson Mogollón",
        "email": "johander1822@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/agentica-lang/tree-sitter-agentica"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
